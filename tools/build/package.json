{
  "name": "infcanvas-vuebuild",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --loader:.css=text --alias:vue=vue/dist/vue.esm-bundler.js --define:process.env.NODE_ENV='\"production\"' --define:__VUE_OPTIONS_API__=true --define:__VUE_PROD_DEVTOOLS__=false --define:__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false --outfile=../../js/vendor/vueflow.bundle.mjs"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "esbuild": "^0.28.2",
    "vue": "3.5.42"
  }
}
